{
  "routes": [
    {
      "routePath": "/api/:route*",
      "mountPath": "/api",
      "method": "OPTIONS",
      "module": [
        "api/[[route]].js:onRequestOptions"
      ]
    },
    {
      "routePath": "/api/:route*",
      "mountPath": "/api",
      "method": "",
      "module": [
        "api/[[route]].js:onRequest"
      ]
    }
  ],
  "baseURL": "/"
}