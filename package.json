{
  "name": "riuph-cloud-services",
  "version": "1.0.0",
  "description": "Unified Multi-Domain Engine for ATS Master Screener (ats.riuph.me) and Academic Plagiarism & AI Checker (checker.riuph.me)",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "build:ats": "vite build --config apps/ats/vite.config.js",
